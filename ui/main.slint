import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";

export struct DiskRow { name: string, detail: string, size: string, style: string, tag: string }
export struct PartRow { num: string, type: string, fs: string, size: string, offset: string, volume: string }
export struct SegRow { label: string, size: string, start: float, fraction: float, free: bool }
export struct PlanSeg { label: string, size: string, start: float, fraction: float, free: bool, changed: bool }
export struct DiagRow { severity: int, text: string }

export global Tr {
    in property <string> app-title;
    in property <string> disks;
    in property <string> partitions;
    in property <string> diagnostics;
    in property <string> filter-hint;
    in property <string> refresh;
    in property <string> theme;
    in property <string> language;
    in property <string> density;
    in property <string> about;
    in property <string> close;
    in property <string> loading;
    in property <string> empty;
    in property <string> error-prefix;
    in property <string> read-only;
    in property <string> health;
    in property <string> no-diag;
    in property <string> col-num;
    in property <string> col-type;
    in property <string> col-fs;
    in property <string> col-size;
    in property <string> col-offset;
    in property <string> col-volume;
    in property <string> free-space;
    in property <string> copyright;
    in property <string> select-disk;
    in property <[string]> theme-options;
    in property <[string]> density-options;
    in property <[string]> bus-filter-options;
    in property <[string]> kind-filter-options;
    in property <[string]> health-filter-options;
    in property <string> tools;
    in property <string> t-hash;
    in property <string> t-image;
    in property <string> t-scan;
    in property <string> t-recover;
    in property <string> t-files;
    in property <string> t-extract;
    in property <string> t-hex;
    in property <string> t-open;
    in property <string> t-cancel;
    in property <string> t-prev;
    in property <string> t-next;
    in property <string> t-offset;
    in property <string> t-back;
    in property <string> t-note;
    in property <string> version;
    in property <string> settings;
    in property <string> s-check;
    in property <string> s-install;
    in property <string> s-auto;
    in property <string> s-privacy;
    in property <string> s-notes;
    in property <string> report;
    in property <string> t-ptb;
    in property <string> t-restore;
    in property <string> act-analyze;
    in property <string> act-lost;
    in property <string> act-files;
    in property <string> act-format;
    in property <string> act-partition;
    in property <string> advanced;
    in property <string> t-apply;
    in property <string> plan-title;
    in property <string> plan-reset;
    in property <string> t-clone;
    in property <string> t-clone-apply;
    in property <string> t-clone-target;
    in property <string> t-vhd-create;
    in property <string> t-vhd-attach;
    in property <string> t-vhd-detach;
    in property <string> t-vhd-size;
    in property <string> m-file;
    in property <string> m-disk;
    in property <string> m-view;
    in property <string> m-help;
    in property <string> m-exit;
    in property <string> tb-clone;
    in property <string> tb-restore;
    in property <string> c-part;
    in property <string> c-disk;
    in property <string> c-plan;
    in property <[string]> c-future;
    in property <[string]> c-ops;
    in property <string> e-start;
    in property <string> e-size;
    in property <string> e-type;
    in property <string> e-preview;
    in property <string> e-apply;
    in property <string> t-confirm-hint;
    in property <bool> restore-ready: false;
    in-out property <string> restore-confirm;
    callback restore-preview();
    callback restore-apply(string);
}

component ToolBtn inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <color> tint: Palette.accent-foreground;
    in property <bool> enabled: true;
    callback clicked();
    width: max(64px, lbl.preferred-width + 14px);
    border-radius: 4px;
    background: ta.pressed && root.enabled ? Palette.border : ta.has-hover && root.enabled ? Palette.border.with-alpha(0.5) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    opacity: root.enabled ? 1.0 : 0.4;
    VerticalLayout {
        padding-top: 5px; padding-bottom: 3px; spacing: 3px;
        Rectangle {
            height: 32px;
            Path {
                width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                commands: root.icon;
                stroke: root.tint; stroke-width: 1.9px;
                stroke-line-cap: round; stroke-line-join: round;
            }
        }
        lbl := Text { text: root.label; font-size: 11px; horizontal-alignment: center; color: Palette.foreground; overflow: elide; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TabBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: max(90px, t.preferred-width + 24px);
    background: root.active ? Palette.background : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Palette.border;
    t := Text { text: root.label; font-weight: root.active ? 700 : 400; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
component Section inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: Palette.foreground;
}

component Cell inherits Text {
    overflow: elide;
    vertical-alignment: center;
    color: Palette.foreground;
}

export component MainWindow inherits Window {
    title: Tr.app-title;
    min-width: 980px;
    min-height: 560px;
    preferred-width: 1180px;
    preferred-height: 760px;
    background: Palette.background;

    in property <[DiskRow]> disks;
    in property <[PartRow]> parts;
    in property <[PlanSeg]> plan-segs;
    in property <string> plan-text;
    callback plan-hit(float, float) -> int;
    callback plan-press(float, float);
    callback plan-drag(float);
    callback plan-release();
    callback plan-reset();
    in property <bool> clone-ready: false;
    in-out property <string> clone-confirm;
    in-out property <string> clone-target;
    callback clone-preview(string);
    callback clone-apply(string);
    in property <[SegRow]> segments;
    in property <[DiagRow]> diags;
    in property <string> health-text;
    in property <bool> loading: true;
    in-out property <bool> show-tools: false;
    in-out property <int> task-mode: 0;
    in property <string> source-label;
    in property <bool> tool-busy: false;
    in property <float> tool-progress: 0;
    in property <string> tool-status;
    in property <string> tool-output;
    in-out property <string> hex-offset: "0";
    in-out property <string> recovery-candidate: "1";
    in property <string> error-text;
    in-out property <int> selected: -1;
    in-out property <string> filter-text;
    in-out property <bool> show-about: false;
    in-out property <bool> show-settings: false;
    in property <string> upd-text;
    in property <string> upd-notes;
    in property <float> upd-progress: 0;
    in property <bool> upd-can-install: false;
    in property <bool> upd-busy: false;
    in property <bool> auto-update: false;
    in property <string> report-status;
    callback export-report();
    callback check-updates();
    callback start-update();
    callback auto-update-changed(bool);
    in property <int> theme-index: 0;
    in property <int> density-index: 1;
    in property <int> language-index: 0;
    property <length> row-h: [28px, 36px, 46px][density-index];
    changed theme-index => {
        Palette.color-scheme = theme-index == 1 ? ColorScheme.light : theme-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    callback refresh();
    callback quit();
    callback ctx-action(string, int);
    callback part-selected(int);
    in property <int> part-sel: -1;
    callback tool-run(string, string);
    callback tool-open-file();
    callback tool-cancel();
    in-out property <string> vhd-size: "128";
    callback vhd-create();
    callback vhd-attach();
    callback vhd-detach();
    in property <bool> part-ready: false;
    in-out property <string> part-confirm;
    in-out property <string> edit-start;
    in-out property <string> edit-size;
    in-out property <string> edit-type: "ntfs";
    callback part-preview(string, int);
    callback part-apply(string);
    in property <bool> restore-ready: false;
    in-out property <string> restore-confirm;
    callback restore-preview();
    callback restore-apply(string);
    callback disk-selected(int);
    callback filter-changed(string);
    callback bus-filter-changed(string);
    callback kind-filter-changed(string);
    callback health-filter-changed(string);
    callback theme-changed(int);
    callback density-changed(int);
    callback language-changed(int);

    MenuBar {
        Menu {
            title: Tr.m-file;
            MenuItem { title: Tr.report; enabled: root.disks.length > 0; activated => { root.export-report(); } }
            MenuItem { title: Tr.settings; activated => { root.show-settings = true; } }
            MenuItem { title: Tr.m-exit; activated => { root.quit(); } }
        }
        Menu {
            title: Tr.m-disk;
            MenuItem { title: Tr.refresh; activated => { root.refresh(); } }
            MenuItem { title: Tr.t-clone; enabled: root.selected >= 0; activated => { root.show-tools = true; } }
            MenuItem { title: Tr.t-restore; enabled: root.selected >= 0; activated => { root.show-tools = true; root.restore-preview(); } }
            MenuItem { title: Tr.t-ptb; enabled: root.selected >= 0; activated => { root.show-tools = true; root.tool-run("ptbackup", ""); } }
        }
        Menu {
            title: Tr.advanced;
            MenuItem { title: Tr.t-hash; activated => { root.show-tools = true; root.tool-run("hash", ""); } }
            MenuItem { title: Tr.t-image; activated => { root.show-tools = true; root.tool-run("image", ""); } }
            MenuItem { title: Tr.t-recover; activated => { root.show-tools = true; root.tool-run("recover", ""); } }
            MenuItem { title: Tr.t-scan; activated => { root.show-tools = true; root.tool-run("scan", ""); } }
            MenuItem { title: Tr.t-hex; activated => { root.show-tools = true; root.tool-run("hex", root.hex-offset); } }
            MenuItem { title: Tr.t-open; activated => { root.show-tools = true; root.tool-open-file(); } }
        }
        Menu {
            title: Tr.m-view;
            MenuItem { title: Tr.theme + ": " + Tr.theme-options[0]; activated => { root.theme-changed(0); } }
            MenuItem { title: Tr.theme + ": " + Tr.theme-options[1]; activated => { root.theme-changed(1); } }
            MenuItem { title: Tr.theme + ": " + Tr.theme-options[2]; activated => { root.theme-changed(2); } }
            MenuItem { title: Tr.density + ": " + Tr.density-options[0]; activated => { root.density-changed(0); } }
            MenuItem { title: Tr.density + ": " + Tr.density-options[1]; activated => { root.density-changed(1); } }
            MenuItem { title: Tr.density + ": " + Tr.density-options[2]; activated => { root.density-changed(2); } }
            MenuItem { title: "Español"; activated => { root.language-changed(0); } }
            MenuItem { title: "English"; activated => { root.language-changed(1); } }
        }
        Menu {
            title: Tr.m-help;
            MenuItem { title: Tr.s-check; activated => { root.show-settings = true; } }
            MenuItem { title: Tr.about; activated => { root.show-about = true; } }
        }
    }

    VerticalLayout {
        // ---- icon toolbar ----
        Rectangle {
            height: 66px;
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                spacing: 2px;
                alignment: start;
                ToolBtn { label: Tr.refresh; icon: "M20 12a8 8 0 1 1-2.3-5.6 M20 4v5h-5"; enabled: !root.loading; clicked => { root.refresh(); } }
                ToolBtn { label: Tr.report; icon: "M6 3h8l4 4v14H6z M14 3v4h4 M9 12h6 M9 16h6"; enabled: !root.loading && root.disks.length > 0; clicked => { root.export-report(); } }
                Rectangle { width: 1px; background: Palette.border; }
                ToolBtn { label: Tr.act-analyze; tint: #1687d9; icon: "M3 12s3-7 9-7 9 7 9 7-3 7-9 7-9-7-9-7z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"; enabled: root.selected >= 0; clicked => { root.ctx-action("scan", -1); } }
                ToolBtn { label: Tr.act-lost; tint: #7956c8; icon: "M4 5h16v14H4z M8 9h8 M8 13h5 M16 16l2 2"; enabled: root.selected >= 0; clicked => { root.ctx-action("recover", -1); } }
                ToolBtn { label: Tr.act-files; tint: #20976b; icon: "M6 3h9l4 4v14H6z M15 3v5h4 M9 13h7 M9 17h5"; enabled: root.selected >= 0 && root.part-sel >= 0; clicked => { root.ctx-action("files", root.part-sel); } }
                ToolBtn { label: Tr.act-format; tint: #d38720; icon: "M4 5h16v14H4z M8 9h8 M8 13h8 M8 17h4"; enabled: root.selected >= 0 && root.part-sel >= 0; clicked => { root.ctx-action("p:format", root.part-sel); } }
                ToolBtn { label: Tr.act-partition; tint: #e06464; icon: "M4 4h16v16H4z M12 4v16 M4 12h8"; enabled: root.selected >= 0; clicked => { root.ctx-action("p:create", -1); } }
                Rectangle { width: 1px; background: Palette.border; }
                ToolBtn { label: Tr.settings; icon: "M4 7h10 M18 7h2 M4 17h2 M10 17h10 M16 5v4 M8 15v4"; clicked => { root.show-settings = true; } }
                ToolBtn { label: Tr.about; icon: "M12 3a9 9 0 1 0 .001 0z M12 11v6 M12 7.5v.5"; clicked => { root.show-about = true; } }
            }
        }
        Rectangle { height: 1px; background: Palette.border; }

        if root.loading: Text {
            text: Tr.loading;
            color: Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: text;
        }
        if !root.loading && root.error-text != "": Text {
            text: Tr.error-prefix + root.error-text;
            color: #d9534f;
            wrap: word-wrap;
        }
        if !root.loading && root.error-text == "" && root.disks.length == 0: Text {
            text: Tr.empty;
            color: Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // ---- disk bars (selected disk) ----
        if !root.loading && root.selected >= 0: Rectangle {
            vertical-stretch: 0;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text {
                    text: root.disks[root.selected].name + "   " + root.disks[root.selected].size + " · " + root.disks[root.selected].style;
                    font-weight: 700; font-size: 12px; color: Palette.foreground; overflow: elide;
                }
                Rectangle {
                    height: 50px;
                    accessible-role: image;
                    accessible-label: Tr.partitions;
                    for s in root.segments: Rectangle {
                        x: parent.width * s.start;
                        width: max(parent.width * s.fraction - 2px, 1px);
                        height: parent.height;
                        border-radius: 3px;
                        background: s.free ? Palette.background : Palette.accent-background.with-alpha(0.85);
                        border-width: 1px;
                        border-color: Palette.border;
                        clip: true;
                        accessible-role: text;
                        accessible-label: s.label + " " + s.size;
                        VerticalLayout {
                            padding: 4px;
                            Text { text: s.label; overflow: elide; font-size: 11px; font-weight: 600; color: s.free ? Palette.foreground : Palette.accent-foreground; }
                            Text { text: s.size; overflow: elide; font-size: 10px; color: s.free ? Palette.foreground.with-alpha(0.7) : Palette.accent-foreground; }
                        }
                    }
                }
                if root.plan-segs.length > 0: VerticalLayout {
                    spacing: 3px;
                    Text { text: Tr.plan-title; font-size: 10px; color: Palette.foreground.with-alpha(0.8); overflow: elide; }
                    Rectangle {
                        height: 30px;
                        accessible-role: image;
                        accessible-label: Tr.plan-title;
                        for s in root.plan-segs: Rectangle {
                            x: parent.width * s.start;
                            width: max(parent.width * s.fraction - 1px, 1px);
                            height: parent.height;
                            border-radius: 3px;
                            background: s.free ? Palette.background : s.changed ? #d98a1e : Palette.accent-background.with-alpha(0.85);
                            border-width: 1px;
                            border-color: Palette.border;
                            clip: true;
                            Text { x: 3px; y: 1px; text: s.free ? "" : s.label; font-size: 10px; font-weight: 600; color: Palette.accent-foreground; overflow: elide; }
                            Text { x: 3px; y: 14px; text: s.size; font-size: 9px; color: s.free ? Palette.foreground.with-alpha(0.7) : Palette.accent-foreground; overflow: elide; }
                            if !s.free: Rectangle { x: parent.width - 5px; y: 6px; width: 3px; height: parent.height - 12px; border-radius: 1px; background: Palette.accent-foreground.with-alpha(0.75); }
                            if !s.free: Rectangle { x: 2px; y: 6px; width: 3px; height: parent.height - 12px; border-radius: 1px; background: Palette.accent-foreground.with-alpha(0.75); }
                        }
                        plan-ta := TouchArea {
                            property <MouseCursor> cur: MouseCursor.default;
                            mouse-cursor: cur;
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                    root.plan-press(self.mouse-x / self.width, 9px / self.width);
                                } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                    root.plan-release();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.plan-drag(self.mouse-x / self.width);
                                } else {
                                    let h = root.plan-hit(self.mouse-x / self.width, 9px / self.width);
                                    cur = h == 1 ? MouseCursor.ew-resize : h == 2 ? MouseCursor.move : MouseCursor.default;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { horizontal-stretch: 1; vertical-alignment: center; text: root.plan-text; font-size: 11px; color: Palette.foreground; overflow: elide; }
                        Button { text: Tr.plan-reset; clicked => { root.plan-reset(); } }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Palette.border; visible: root.selected >= 0; }

        // ---- tree + tabs ----
        if !root.loading && root.disks.length > 0: HorizontalLayout {
            Rectangle {
                width: 250px;
                background: Palette.background;
                VerticalLayout {
                    padding: 6px;
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: Tr.filter-hint;
                        accessible-label: Tr.filter-hint;
                        edited(t) => { root.filter-changed(t); }
                    }
                    ComboBox {
                        model: Tr.bus-filter-options;
                        accessible-label: Tr.bus-filter-options[0];
                        selected(item) => { root.bus-filter-changed(item); }
                    }
                    ComboBox {
                        model: Tr.kind-filter-options;
                        accessible-label: Tr.kind-filter-options[0];
                        selected(item) => { root.kind-filter-changed(item); }
                    }
                    ComboBox {
                        model: Tr.health-filter-options;
                        accessible-label: Tr.health-filter-options[0];
                        selected(item) => { root.health-filter-changed(item); }
                    }
                    fs := FocusScope {
                        key-pressed(e) => {
                            if (e.text == Key.DownArrow && root.selected < root.disks.length - 1) {
                                root.disk-selected(root.selected + 1);
                                return accept;
                            }
                            if (e.text == Key.UpArrow && root.selected > 0) {
                                root.disk-selected(root.selected - 1);
                                return accept;
                            }
                            reject
                        }
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                for d[i] in root.disks: VerticalLayout {
                                    Rectangle {
                                        height: 26px;
                                        background: i == root.selected ? Palette.accent-background : transparent;
                                        accessible-role: list-item;
                                        accessible-label: d.name + ", " + d.size + ", " + d.style;
                                        accessible-item-selectable: true;
                                        accessible-item-selected: i == root.selected;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 4px; spacing: 6px;
                                            Rectangle {
                                                width: 18px;
                                                Path {
                                                    width: 18px; height: 18px; viewbox-width: 24; viewbox-height: 24;
                                                    commands: "M3 8h18v8H3z M6 12h.5 M16 12h3";
                                                    stroke: i == root.selected ? Palette.accent-foreground : Palette.foreground;
                                    stroke-width: 1.8px;
                                                }
                                            }
                                            Text {
                                                text: d.name + (d.tag != "" ? "  [" + d.tag + "]" : "");
                                                overflow: elide; vertical-alignment: center; font-weight: 600; font-size: 12px;
                                                color: i == root.selected ? Palette.accent-foreground : Palette.foreground;
                                            }
                                        }
                                        TouchArea { clicked => { fs.focus(); root.disk-selected(i); } }
                                    }
                                    if i == root.selected: VerticalLayout {
                                        for p in root.parts: Rectangle {
                                            height: 22px;
                                            HorizontalLayout {
                                                padding-left: 30px; spacing: 6px;
                                                Rectangle {
                                                    width: 12px;
                                                    Rectangle { width: 10px; height: 10px; border-radius: 2px; background: p.fs == "" ? Palette.border : Palette.accent-background; }
                                                }
                                                Text {
                                                    text: (p.volume != "" ? p.volume + "  " : "") + "#" + p.num + "  " + p.size;
                                                    overflow: elide; vertical-alignment: center; font-size: 11px; color: Palette.foreground;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Palette.border; }

            VerticalLayout {
                // tab strip
                Rectangle {
                    height: 30px;
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        alignment: start;
                        TabBtn { label: Tr.partitions; active: !root.show-tools; clicked => { root.show-tools = false; root.task-mode = 0; } }
                        TabBtn { label: root.task-mode == 0 ? Tr.advanced : Tr.t-back; active: root.show-tools; clicked => { root.show-tools = root.task-mode == 0; root.task-mode = 0; } }
                    }
                }
                Rectangle { height: 1px; background: Palette.border; }

                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;

                    if root.selected < 0 && !root.show-tools: Text { text: Tr.select-disk; color: Palette.foreground; }

                    if root.selected >= 0 && !root.show-tools: Rectangle {
                        border-width: 1px;
                        border-color: Palette.border;
                        VerticalLayout {
                            Rectangle {
                                height: root.row-h;
                                background: Palette.alternate-background;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    spacing: 6px;
                                    Cell { text: Tr.col-num; width: 36px; font-weight: 700; }
                                    Cell { text: Tr.col-type; width: 140px; font-weight: 700; }
                                    Cell { text: Tr.col-fs; width: 70px; font-weight: 700; }
                                    Cell { text: Tr.col-size; width: 90px; font-weight: 700; }
                                    Cell { text: Tr.col-offset; width: 110px; font-weight: 700; }
                                    Cell { text: Tr.col-volume; font-weight: 700; }
                                }
                            }
                            ListView {
                                for p[i] in root.parts: Rectangle {
                                    height: root.row-h;
                                    background: i == root.part-sel ? Palette.accent-background.with-alpha(0.35) : mod(i, 2) == 1 ? Palette.alternate-background.with-alpha(0.5) : transparent;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 6px;
                                        Cell { text: p.num; width: 36px; }
                                        Cell { text: p.type; width: 140px; }
                                        Cell { text: p.fs; width: 70px; }
                                        Cell { text: p.size; width: 90px; }
                                        Cell { text: p.offset; width: 110px; color: Palette.foreground.with-alpha(0.6); font-italic: true; }
                                        Cell { text: p.volume; }
                                    }
                                    TouchArea { clicked => { root.part-selected(i); } }
                                    ContextMenuArea {
                                        Menu {
                                            MenuItem { title: Tr.t-hex + " (" + Tr.c-part + ")"; activated => { root.part-selected(i); root.ctx-action("hex", i); } }
                                            MenuItem { title: Tr.t-hash + " (" + Tr.c-part + ")"; activated => { root.part-selected(i); root.ctx-action("hash", i); } }
                                            MenuItem { title: Tr.t-image + " (" + Tr.c-part + ")"; activated => { root.part-selected(i); root.ctx-action("image", i); } }
                                            MenuItem { title: Tr.t-scan + " (" + Tr.c-part + ")"; activated => { root.part-selected(i); root.ctx-action("scan", i); } }
                                            MenuItem { title: Tr.t-files; activated => { root.part-selected(i); root.ctx-action("files", i); } }
                                            MenuSeparator {}
                                            Menu {
                                                title: Tr.c-disk;
                                                MenuItem { title: Tr.t-ptb; activated => { root.ctx-action("ptbackup", -1); } }
                                                MenuItem { title: Tr.t-clone; activated => { root.ctx-action("clone", -1); } }
                                                MenuItem { title: Tr.t-restore; activated => { root.ctx-action("restore", -1); } }
                                                MenuItem { title: Tr.report; activated => { root.ctx-action("report", -1); } }
                                            }
                                            MenuItem { title: Tr.c-plan; activated => { root.ctx-action("planreset", -1); } }
                                            MenuSeparator {}
                                            MenuItem { title: Tr.c-ops[0]; activated => { root.part-selected(i); root.ctx-action("p:delete", i); } }
                                            MenuItem { title: Tr.c-ops[1]; activated => { root.part-selected(i); root.ctx-action("p:create", i); } }
                                            MenuItem { title: Tr.c-ops[2]; activated => { root.part-selected(i); root.ctx-action("p:resize", i); } }
                                            MenuItem { title: Tr.c-ops[3]; activated => { root.part-selected(i); root.ctx-action("p:merge", i); } }
                                            MenuItem { title: Tr.c-ops[4]; activated => { root.part-selected(i); root.ctx-action("p:settype", i); } }
                                            MenuItem { title: Tr.c-ops[5]; activated => { root.part-selected(i); root.ctx-action("p:setactive", i); } }
                                            Menu {
                                                title: Tr.c-ops[8];
                                                MenuItem { title: Tr.c-ops[6]; activated => { root.ctx-action("p:initmbr", -1); } }
                                                MenuItem { title: Tr.c-ops[7]; activated => { root.ctx-action("p:initgpt", -1); } }
                                            }
                                            MenuItem { title: Tr.c-future[0]; activated => { root.part-selected(i); root.ctx-action("p:format", i); } }
                                            MenuItem { title: Tr.c-future[1]; activated => { root.part-selected(i); root.ctx-action("p:format-exfat", i); } }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.selected >= 0 && !root.show-tools: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 3px;
                        Section { text: Tr.health + ": " + root.health-text; }
                        Section { text: Tr.diagnostics; }
                        if root.diags.length == 0: Text { text: Tr.no-diag; color: Palette.foreground; }
                        for g in root.diags: Text {
                            text: (g.severity == 2 ? "✖ " : g.severity == 1 ? "⚠ " : "• ") + g.text;
                            color: g.severity == 2 ? #d9534f : g.severity == 1 ? #e0a030 : Palette.foreground;
                            wrap: word-wrap;
                        }
                    }

                    if root.show-tools: VerticalLayout {
                        spacing: 8px;
                        Section { text: root.source-label; }
                        if root.task-mode == 1: Section { text: Tr.act-analyze; }
                        if root.task-mode == 2: Section { text: Tr.act-lost; }
                        if root.task-mode == 3: Section { text: Tr.act-files; }
                        if root.task-mode == 4: Section { text: Tr.act-format; }
                        if root.task-mode == 5: Section { text: Tr.act-partition; }
                        Text { text: Tr.t-note; color: Palette.foreground.with-alpha(0.7); font-size: 11px; wrap: word-wrap; visible: root.task-mode == 0 || root.task-mode == 4 || root.task-mode == 5; }
                        if root.task-mode == 0: VerticalLayout {
                          spacing: 8px;
                          HorizontalLayout {
                            spacing: 8px;
                            Button { text: Tr.t-open; enabled: !root.tool-busy; clicked => { root.tool-open-file(); } }
                            Button { text: Tr.t-hash; enabled: !root.tool-busy; clicked => { root.tool-run("hash", ""); } }
                            Button { text: Tr.t-image; enabled: !root.tool-busy; clicked => { root.tool-run("image", ""); } }
                            Button { text: Tr.t-scan; enabled: !root.tool-busy; clicked => { root.tool-run("scan", ""); } }
                            Button { text: Tr.t-recover; enabled: !root.tool-busy; clicked => { root.tool-run("recover", ""); } }
                            Button { text: Tr.t-ptb; enabled: !root.tool-busy; clicked => { root.tool-run("ptbackup", ""); } }
                            Button { text: Tr.t-cancel; enabled: root.tool-busy; clicked => { root.tool-cancel(); } }
                          }
                          HorizontalLayout {
                            spacing: 8px;
                            Text { text: Tr.t-offset; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { width: 160px; text <=> root.hex-offset; accessible-label: Tr.t-offset; }
                            Button { text: Tr.t-hex; enabled: !root.tool-busy; clicked => { root.tool-run("hex", root.hex-offset); } }
                            Button { text: Tr.t-prev; enabled: !root.tool-busy; clicked => { root.tool-run("hexprev", root.hex-offset); } }
                            Button { text: Tr.t-next; enabled: !root.tool-busy; clicked => { root.tool-run("hexnext", root.hex-offset); } }
                          }
                          HorizontalLayout {
                            spacing: 8px;
                            Button { text: Tr.t-files; enabled: !root.tool-busy; clicked => { root.tool-run("files", ""); } }
                            LineEdit { width: 60px; text <=> root.recovery-candidate; accessible-label: Tr.t-extract; }
                            Button { text: Tr.t-extract; enabled: !root.tool-busy; clicked => { root.tool-run("extract", root.recovery-candidate); } }
                          }
                          HorizontalLayout {
                            spacing: 8px;
                            Button { text: Tr.t-restore; enabled: !root.tool-busy; clicked => { root.restore-preview(); } }
                            LineEdit { horizontal-stretch: 1; enabled: root.restore-ready; placeholder-text: Tr.t-confirm-hint; text <=> root.restore-confirm; accessible-label: Tr.t-confirm-hint; }
                            Button { text: Tr.t-apply; enabled: root.restore-ready && !root.tool-busy; clicked => { root.restore-apply(root.restore-confirm); } }
                          }
                          HorizontalLayout {
                            spacing: 8px;
                            Text { text: Tr.t-clone-target; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { width: 60px; text <=> root.clone-target; accessible-label: Tr.t-clone-target; }
                            Button { text: Tr.t-clone; enabled: !root.tool-busy; clicked => { root.clone-preview(root.clone-target); } }
                            LineEdit { horizontal-stretch: 1; enabled: root.clone-ready; placeholder-text: Tr.t-confirm-hint; text <=> root.clone-confirm; accessible-label: Tr.t-confirm-hint; }
                            Button { text: Tr.t-clone-apply; enabled: root.clone-ready && !root.tool-busy; clicked => { root.clone-apply(root.clone-confirm); } }
                          }
                          HorizontalLayout {
                            spacing: 8px;
                            Text { text: Tr.t-vhd-size; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { width: 80px; text <=> root.vhd-size; accessible-label: Tr.t-vhd-size; }
                            Button { text: Tr.t-vhd-create; enabled: !root.tool-busy; clicked => { root.vhd-create(); } }
                            Button { text: Tr.t-vhd-attach; enabled: !root.tool-busy; clicked => { root.vhd-attach(); } }
                            Button { text: Tr.t-vhd-detach; enabled: !root.tool-busy; clicked => { root.vhd-detach(); } }
                          }
                          HorizontalLayout {
                            spacing: 8px;
                            Text { text: Tr.e-start; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { width: 70px; text <=> root.edit-start; accessible-label: Tr.e-start; }
                            Text { text: Tr.e-size; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { width: 70px; text <=> root.edit-size; accessible-label: Tr.e-size; }
                            Text { text: Tr.e-type; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { width: 90px; text <=> root.edit-type; accessible-label: Tr.e-type; }
                            Button { text: Tr.c-ops[1]; enabled: !root.tool-busy; clicked => { root.part-preview("create", -1); } }
                            Button { text: Tr.c-ops[2]; enabled: !root.tool-busy; clicked => { root.part-preview("resize", root.part-sel); } }
                          }
                          HorizontalLayout {
                            spacing: 8px;
                            Text { text: Tr.e-preview; color: Palette.foreground; vertical-alignment: center; }
                            LineEdit { horizontal-stretch: 1; enabled: root.part-ready; placeholder-text: Tr.t-confirm-hint; text <=> root.part-confirm; accessible-label: Tr.t-confirm-hint; }
                            Button { text: Tr.e-apply; enabled: root.part-ready && !root.tool-busy; clicked => { root.part-apply(root.part-confirm); } }
                          }
                        }
                        if root.task-mode == 3: HorizontalLayout {
                            spacing: 8px;
                            LineEdit { width: 70px; text <=> root.recovery-candidate; accessible-label: Tr.t-extract; }
                            Button { text: Tr.t-extract; enabled: !root.tool-busy; clicked => { root.tool-run("extract", root.recovery-candidate); } }
                        }
                        if root.task-mode == 4: VerticalLayout {
                            spacing: 6px;
                            Section { text: Tr.act-format + " · " + Tr.c-part; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: Tr.c-future[0]; enabled: !root.tool-busy; clicked => { root.part-preview("format", root.part-sel); } }
                                Button { text: Tr.c-future[1]; enabled: !root.tool-busy; clicked => { root.part-preview("format-exfat", root.part-sel); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { horizontal-stretch: 1; enabled: root.part-ready; placeholder-text: Tr.t-confirm-hint; text <=> root.part-confirm; accessible-label: Tr.t-confirm-hint; }
                                Button { text: Tr.e-apply; enabled: root.part-ready && !root.tool-busy; clicked => { root.part-apply(root.part-confirm); } }
                            }
                        }
                        if root.task-mode == 5: VerticalLayout {
                            spacing: 6px;
                            Section { text: Tr.act-partition; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: Tr.e-start; color: Palette.foreground; vertical-alignment: center; }
                                LineEdit { width: 80px; text <=> root.edit-start; accessible-label: Tr.e-start; }
                                Text { text: Tr.e-size; color: Palette.foreground; vertical-alignment: center; }
                                LineEdit { width: 80px; text <=> root.edit-size; accessible-label: Tr.e-size; }
                                Text { text: Tr.e-type; color: Palette.foreground; vertical-alignment: center; }
                                LineEdit { width: 90px; text <=> root.edit-type; accessible-label: Tr.e-type; }
                                Button { text: Tr.e-preview; enabled: !root.tool-busy; clicked => { root.part-preview("create", -1); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { horizontal-stretch: 1; enabled: root.part-ready; placeholder-text: Tr.t-confirm-hint; text <=> root.part-confirm; accessible-label: Tr.t-confirm-hint; }
                                Button { text: Tr.e-apply; enabled: root.part-ready && !root.tool-busy; clicked => { root.part-apply(root.part-confirm); } }
                            }
                        }
                        if root.task-mode == 1 || root.task-mode == 2: Button { text: Tr.t-cancel; enabled: root.tool-busy; clicked => { root.tool-cancel(); } }
                        Rectangle {
                            height: 14px;
                            border-width: 1px; border-color: Palette.border;
                            accessible-role: progress-indicator;
                            accessible-value: root.tool-status;
                            Rectangle { x: 0; width: parent.width * root.tool-progress; background: Palette.accent-background; }
                        }
                        Text { text: root.tool-status; color: Palette.foreground; wrap: word-wrap; }
                        Rectangle {
                            border-width: 1px; border-color: Palette.border; clip: true;
                            ScrollView {
                                Text { x: 0; horizontal-alignment: left; text: root.tool-output; font-family: "Consolas"; font-size: 12px; color: Palette.foreground; }
                            }
                        }
                    }
                }
            }
        }

        // ---- status bar ----
        Rectangle { height: 1px; background: Palette.border; }
        Rectangle {
            height: 24px;
            background: Palette.alternate-background;
            Text {
                x: 8px; width: parent.width - 16px;
                text: root.report-status != "" ? root.report-status : Tr.read-only;
                vertical-alignment: center; overflow: elide; font-size: 11px;
                color: Palette.foreground.with-alpha(0.8);
            }
        }
    }

    if root.show-settings: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: min(520px, root.width - 40px);
            height: min(460px, root.height - 40px);
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: Tr.settings; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                Text { text: Tr.app-title + " " + Tr.version; color: Palette.foreground; }
                CheckBox {
                    text: Tr.s-auto;
                    checked: root.auto-update;
                    toggled => { root.auto-update-changed(self.checked); }
                }
                Text { text: Tr.s-privacy; color: Palette.foreground.with-alpha(0.7); font-size: 11px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: Tr.s-check; enabled: !root.upd-busy; clicked => { root.check-updates(); } }
                    Button { text: Tr.s-install; enabled: root.upd-can-install && !root.upd-busy; clicked => { root.start-update(); } }
                }
                Rectangle {
                    height: 14px;
                    border-width: 1px; border-color: Palette.border;
                    accessible-role: progress-indicator;
                    accessible-value: root.upd-text;
                    Rectangle { x: 0; width: parent.width * root.upd-progress; background: Palette.accent-background; }
                }
                Text { text: root.upd-text; color: Palette.foreground; wrap: word-wrap; accessible-role: text; }
                Text { text: Tr.s-notes; font-weight: 700; color: Palette.foreground; visible: root.upd-notes != ""; }
                Rectangle {
                    border-width: 1px; border-color: Palette.border; clip: true;
                    visible: root.upd-notes != "";
                    ScrollView {
                        Text { x: 0; width: parent.width - 12px; text: root.upd-notes; wrap: word-wrap; color: Palette.foreground; font-size: 12px; }
                    }
                }
                Button { text: Tr.close; enabled: !root.upd-busy; clicked => { root.show-settings = false; } }
            }
        }
    }
    if root.show-about: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: 380px;
            height: 280px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: Tr.app-title + " " + Tr.version; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                Text { text: Tr.copyright; color: Palette.foreground; wrap: word-wrap; }
                Text { text: "MIT · dev.gonzalocn.com"; color: Palette.foreground; }
                AboutSlint { }
                Button { text: Tr.close; clicked => { root.show-about = false; } }
            }
        }
    }
}
